<%- include("partials/header") %>

<main class="container">
    <h1><%= isEditing ? "Edit Item" : "Add Item" %></h1>

    <% if (typeof errors !== "undefined" && errors.length > 0) { %>
        <ul class="errors">
            <% errors.forEach((error) => { %>
                <li><%= error.msg %></li>
            <% }) %>
        </ul>
    <% } %>

    <form
        action="<%= isEditing ? `/items/${item.id}/update` : '/items/new' %>"
        method="POST"
    >
        <div>
            <label for="category_id">Category</label>
            <select id="category_id" name="category_id" required>
                <option value="">Select a category</option>

                <% categories.forEach((category) => { %>
                    <option
                        value="<%= category.id %>"
                        <%= item && item.category_id == category.id ? "selected" : "" %>
                    >
                        <%= category.name %>
                    </option>
                <% }) %>
            </select>
        </div>

        <div>
            <label for="name">Item Name</label>
            <input
                type="text"
                id="name"
                name="name"
                value="<%= item ? item.name : '' %>"
                required
            >
        </div>

        <div>
            <label for="description">Description</label>
            <textarea
                id="description"
                name="description"
            ><%= item ? item.description || '' : '' %></textarea>
        </div>

        <div>
            <label for="stock">Stock</label>
            <input
                type="number"
                id="stock"
                name="stock"
                min="0"
                step="1"
                value="<%= item ? item.stock : '' %>"
                required
            >
        </div>

        <div>
            <label for="price">Price ($)</label>
            <input
                type="number"
                id="price"
                name="price"
                min="0"
                step="0.01"
                value="<%= item ? item.price : '' %>"
                required
            >
        </div>

        <div>
            <label for="image_url">Image URL</label>
            <input
                type="url"
                id="image_url"
                name="image_url"
                value="<%= item ? item.image_url || '' : '' %>"
            >
        </div>

        <button type="submit">
            <%= isEditing ? "Update Item" : "Create Item" %>
        </button>
    </form>

    <a href="/items">Cancel</a>
</main>

<%- include("partials/footer") %>