<%- include("partials/header") %>
    <main class="container">

        <div class="page-header">
            <div>
                <h1>
                    <%= category.name %>
                </h1>
                <p>
                    <%= category.description %>
                </p>
            </div>

            <div class="actions">

                <a href="/categories/<%= category.id %>/update" class="btn">
                    Edit Category
                </a>

                <form action="/categories/<%= category.id %>/delete" method="POST"
                    onsubmit="return confirm('Are you sure? Deleting this category will also delete all its items.');">
                    <button type="submit" class="delete-btn">Delete Category</button>
                </form>


            </div>

        </div>

        <h2>Products</h2>

        <% if (items.length===0) { %>
            <p class="empty-message">No items in this category yet.</p>
            <% } else { %>
                <div class="item-list">
                    <% items.forEach((item)=> { %>
                        <article class="item-card">

                            <div class="item-info">

                                <h2>
                                    <a href="/items/<%= item.id %>">
                                        <%= item.name %>
                                    </a>
                                </h2>

                                <p>Price: $<%= item.price %></p>
                                <p>Stock: <%= item.stock %></p>

                            </div>

                            <% if (item.image_url) { %>
                                <img src="<%= item.image_url %>" alt="<%= item.name %>">
                            <% } %>

                        </article>
                        <% }) %>
                </div>
                <% } %>

    </main>

    <%- include("partials/footer") %>